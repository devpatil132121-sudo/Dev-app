<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SafeHer - Women Safety</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f5f5f5;
  color:#222;
}

header{
  background:#8e24aa;
  color:white;
  padding:22px;
  text-align:center;
}

header h1{
  font-size:28px;
}

header p{
  margin-top:6px;
  opacity:.9;
}

.container{
  max-width:500px;
  margin:auto;
  padding:20px;
}

.sos{
  width:190px;
  height:190px;
  border-radius:50%;
  border:none;
  background:#e53935;
  color:white;
  font-size:30px;
  font-weight:bold;
  display:block;
  margin:25px auto;
  box-shadow:0 8px 25px #999;
  cursor:pointer;
}

.sos:active{
  transform:scale(.95);
}

.card{
  background:white;
  padding:18px;
  margin:15px 0;
  border-radius:15px;
  box-shadow:0 3px 12px #ddd;
}

.card h2{
  margin-bottom:12px;
  color:#8e24aa;
}

input{
  width:100%;
  padding:13px;
  margin:7px 0;
  border:1px solid #ccc;
  border-radius:8px;
}

button.action{
  width:100%;
  padding:13px;
  margin-top:8px;
  border:none;
  border-radius:8px;
  background:#8e24aa;
  color:white;
  font-size:16px;
  cursor:pointer;
}

button.call{
  background:#2e7d32;
}

button.location{
  background:#1565c0;
}

button.alarm{
  background:#ef6c00;
}

#status{
  text-align:center;
  margin:15px 0;
  font-weight:bold;
}
</style>
</head>

<body>

<header>
  <h1>🛡️ SafeHer</h1>
  <p>Women Safety & Emergency App</p>
</header>

<div class="container">

  <button class="sos" onclick="sendSOS()">
    🆘<br>SOS
  </button>

  <div id="status"></div>

  <div class="card">
    <h2>👥 Trusted Contact</h2>

    <input
      id="contactName"
      type="text"
      placeholder="Contact Name">

    <input
      id="contactNumber"
      type="tel"
      placeholder="Mobile Number">

    <button class="action" onclick="saveContact()">
      💾 Save Contact
    </button>
  </div>

  <div class="card">
    <h2>📞 Emergency Call</h2>

    <button class="action call" onclick="callContact()">
      📞 Call Trusted Contact
    </button>

    <button class="action call" onclick="callEmergency()">
      🚨 Emergency Call - 112
    </button>
  </div>

  <div class="card">
    <h2>📍 My Location</h2>

    <button class="action location" onclick="shareLocation()">
      📍 Share My Location
    </button>
  </div>

  <div class="card">
    <h2>🔊 Safety Alarm</h2>

    <button class="action alarm" onclick="startAlarm()">
      🔊 Start Alarm
    </button>

    <button class="action" onclick="stopAlarm()">
      🔇 Stop Alarm
    </button>
  </div>

</div>

<script>

let contactNumber =
  localStorage.getItem("contactNumber") || "";

let alarmInterval = null;
let audioContext = null;

function saveContact(){

  const name =
    document.getElementById("contactName").value.trim();

  const number =
    document.getElementById("contactNumber").value.trim();

  if(!name || !number){
    showStatus("कृपया नाव आणि mobile number भरा.");
    return;
  }

  localStorage.setItem("contactName",name);
  localStorage.setItem("contactNumber",number);

  contactNumber = number;

  showStatus("✅ Trusted contact saved.");
}

function callContact(){

  if(!contactNumber){
    showStatus("आधी Trusted Contact save करा.");
    return;
  }

  window.location.href =
    "tel:" + contactNumber;
}

function callEmergency(){

  window.location.href = "tel:112";
}

function shareLocation(){

  if(!navigator.geolocation){
    showStatus("Location सुविधा उपलब्ध नाही.");
    return;
  }

  showStatus("📍 Location शोधत आहे...");

  navigator.geolocation.getCurrentPosition(

    function(position){

      const lat =
        position.coords.latitude;

      const lon =
        position.coords.longitude;

      const mapLink =
        "https://www.google.com/maps?q="
        + lat + "," + lon;

      if(navigator.share){

        navigator.share({
          title:"My Emergency Location",
          text:"🚨 मला मदतीची गरज आहे. माझी location:",
          url:mapLink
        });

      }else{

        navigator.clipboard.writeText(mapLink);

        showStatus(
          "✅ Location link copied."
        );
      }
    },

    function(){

      showStatus(
        "❌ Location मिळाली नाही. Location permission तपासा."
      );
    }
  );
}

function sendSOS(){

  if(!contactNumber){

    showStatus(
      "⚠️ आधी Trusted Contact save करा."
    );

    return;
  }

  startAlarm();

  if(navigator.geolocation){

    navigator.geolocation.getCurrentPosition(

      function(position){

        const lat =
          position.coords.latitude;

        const lon =
          position.coords.longitude;

        const mapLink =
          "https://www.google.com/maps?q="
          + lat + "," + lon;

        const message =
          "🚨 EMERGENCY! मला मदतीची गरज आहे. माझी location: "
          + mapLink;

        window.location.href =
          "sms:" + contactNumber +
          "?body=" + encodeURIComponent(message);
      },

      function(){

        const message =
          "🚨 EMERGENCY! मला मदतीची गरज आहे.";

        window.location.href =
          "sms:" + contactNumber +
          "?body=" + encodeURIComponent(message);
      }
    );

  }else{

    window.location.href =
      "sms:" + contactNumber +
      "?body=" +
      encodeURIComponent(
        "🚨 EMERGENCY! मला मदतीची गरज आहे."
      );
  }
}

function startAlarm(){

  if(alarmInterval) return;

  try{

    audioContext =
      new (window.AudioContext ||
      window.webkitAudioContext)();

    alarmInterval =
      setInterval(function(){

        const oscillator =
          audioContext.createOscillator();

        const gain =
          audioContext.createGain();

        oscillator.frequency.value = 900;
        oscillator.type = "sawtooth";

        gain.gain.value = 0.25;

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.start();

        setTimeout(function(){
          oscillator.stop();
        },500);

      },700);

    showStatus("🔊 Alarm ON");

  }catch(error){

    showStatus(
      "Alarm सुरू करता आला नाही."
    );
  }
}

function stopAlarm(){

  if(alarmInterval){

    clearInterval(alarmInterval);
    alarmInterval = null;
  }

  showStatus("🔇 Alarm OFF");
}

function showStatus(message){

  document.getElementById("status").innerText =
    message;
}


// Load saved contact
window.onload = function(){

  const name =
    localStorage.getItem("contactName");

  const number =
    localStorage.getItem("contactNumber");

  if(name){
    document.getElementById(
      "contactName"
    ).value = name;
  }

  if(number){
    document.getElementById(
      "contactNumber"
    ).value = number;

    contactNumber = number;
  }
};

</script>

</body>
</html>
